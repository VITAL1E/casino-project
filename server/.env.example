DATABASE_URL=postgres://casino:casino@localhost:5432/casino
JWT_SECRET=change-me-to-a-long-random-string
PORT=8787
CLIENT_ORIGIN=http://localhost:5173

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:8787/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/oauth/google/callback

# Discord OAuth (https://discord.com/developers/applications)
# Redirect: http://localhost:8787/api/auth/oauth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8787/api/auth/oauth/discord/callback

# MetaMask/Phantom need no server credentials — they sign a server-issued
# nonce (server/auth/wallet) instead of a client id/secret handshake.

# Sports odds (https://the-odds-api.com) — free tier, 500 requests/month.
# No sportsbook license = no real-money betting, so this is play-money
# against the same demo wallet (server/sports/). Odds are cached
# server-side (ODDS_CACHE_TTL_MS) specifically to stay under that quota.
ODDS_API_KEY=
ODDS_API_BASE=https://api.the-odds-api.com/v4
ODDS_CACHE_TTL_MS=180000
SCORES_CACHE_TTL_MS=180000
SPORTS_SETTLEMENT_INTERVAL_MS=180000

# Live wins feed (server/liveWins.ts) fills with synthetic demo wins so the
# strip isn't empty before real traffic exists. Set to false once it should
# only show real slither/sports payouts.
DEMO_LIVE_WINS=true

# --- production (see README.md > Deploy) ---
# NODE_ENV=production makes the server refuse weak settings (server/env.ts): JWT_SECRET >= 32 random characters,
# CLIENT_ORIGIN must be the public https:// origin.
# TRUST_PROXY=1 when running behind a reverse proxy, so rate limits use the visitor's address (X-Forwarded-For).
TRUST_PROXY=0
# Largest rolling-24h net loss one user can reach before bets are refused (play credits).
WALLET_DAILY_LOSS_LIMIT=20000

# TEMPORARY, testing only: lets the arcade games create a guest account on the fly. Refused when NODE_ENV=production.
# GUEST_PLAY=1
